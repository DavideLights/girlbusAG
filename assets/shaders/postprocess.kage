//kage:unit pixels
package main

var Time float
var Mode float
var Chronos float
var Rewind float
var ScreenSize vec2

func hash21(p vec2) float {
	q := fract(p * vec2(123.34, 456.21))
	d := dot(q, q+vec2(45.32, 45.32))
	q = q + vec2(d, d)
	return fract(q.x * q.y)
}

func sampleClamped(uv vec2, origin vec2, srcSize vec2, minPos vec2, maxPos vec2) vec4 {
	pos := clamp(origin+uv*srcSize, minPos, maxPos)
	return imageSrc0UnsafeAt(pos)
}

func highlightTap(c vec3) vec3 {
	peak := max(c.r, max(c.g, c.b))
	chroma := peak - min(c.r, min(c.g, c.b))
	mask := smoothstep(0.74, 1.0, peak)
	return c * mask * mix(0.36, 1.0, smoothstep(0.08, 0.34, chroma))
}

// dualRingBloom performs an 8-tap isotropic dual-ring optical bloom:
// inner tight glow at 1.5px (cardinal) + outer atmospheric halation at 3.2px (diagonal).
func dualRingBloom(uv vec2, origin vec2, srcSize vec2, minPos vec2, maxPos vec2) vec3 {
	inX := vec2(1.5, 0.0) / srcSize
	inY := vec2(0.0, 1.5) / srcSize
	i0 := highlightTap(sampleClamped(uv+inX, origin, srcSize, minPos, maxPos).rgb)
	i1 := highlightTap(sampleClamped(uv-inX, origin, srcSize, minPos, maxPos).rgb)
	i2 := highlightTap(sampleClamped(uv+inY, origin, srcSize, minPos, maxPos).rgb)
	i3 := highlightTap(sampleClamped(uv-inY, origin, srcSize, minPos, maxPos).rgb)
	inner := (i0 + i1 + i2 + i3) * 0.25

	outStep := vec2(2.263, 2.263) / srcSize
	o0 := highlightTap(sampleClamped(uv+vec2(-outStep.x, -outStep.y), origin, srcSize, minPos, maxPos).rgb)
	o1 := highlightTap(sampleClamped(uv+vec2(outStep.x, -outStep.y), origin, srcSize, minPos, maxPos).rgb)
	o2 := highlightTap(sampleClamped(uv+vec2(-outStep.x, outStep.y), origin, srcSize, minPos, maxPos).rgb)
	o3 := highlightTap(sampleClamped(uv+vec2(outStep.x, outStep.y), origin, srcSize, minPos, maxPos).rgb)
	outer := (o0 + o1 + o2 + o3) * 0.25

	return inner*0.62 + outer*0.38
}

// eveningGrade applies a subtle evening contrast curve with velvety warm indigo-plum
// shadows (#181224) and crisp warm highlights without crushing darks or bullets.
func eveningGrade(rgb vec3, strength float) vec3 {
	c := clamp(rgb, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
	luma := dot(c, vec3(0.299, 0.587, 0.114))

	// Gentle filmic S-curve around midtones.
	sCurve := c * c * (vec3(3.0, 3.0, 3.0) - 2.0*c)
	graded := mix(c, sCurve, 0.12*strength)

	// Deep velvety shadows shifted gently toward warm indigo-plum (#181224).
	indigoPlum := vec3(0.094, 0.071, 0.141)
	shadowMask := (1.0 - smoothstep(0.08, 0.44, luma)) * smoothstep(0.005, 0.06, luma)
	graded = mix(graded, graded*vec3(0.96, 0.92, 1.07)+indigoPlum*0.14, shadowMask*0.36*strength)

	// Crisp warm highlights while preserving bullet hue purity.
	hiMask := smoothstep(0.58, 0.96, luma)
	graded = mix(graded, graded*vec3(1.035, 1.01, 0.965), hiMask*0.42*strength)

	// Subtle saturation preservation so neon accents stay punchy.
	outLuma := dot(graded, vec3(0.299, 0.587, 0.114))
	graded = mix(vec3(outLuma, outLuma, outLuma), graded, 1.0+0.05*strength)
	return graded
}

// applyChronos adds a rich cyan/indigo radial slow-mo rim glow and subtle desaturation shift.
func applyChronos(rgb vec3, cUV vec2, t float, chronosAmt float, intensity float) vec3 {
	rad := length(cUV * vec2(0.92, 1.0))
	rim := smoothstep(0.46, 1.18, rad)
	outerRim := smoothstep(0.74, 1.24, rad)
	pulse := 0.88 + 0.12*sin(t*7.2)

	luma := dot(rgb, vec3(0.299, 0.587, 0.114))
	desat := mix(rgb, vec3(luma, luma, luma), chronosAmt*(0.18+0.20*rim)*intensity)
	coolGrade := desat * vec3(0.86, 0.97, 1.14)
	graded := mix(rgb, coolGrade, chronosAmt*(0.30+0.42*rim)*intensity)

	rimColor := mix(vec3(0.26, 0.14, 0.68), vec3(0.0, 0.96, 0.86), outerRim)
	return graded + rimColor*(rim*pulse*chronosAmt*0.30*intensity)
}

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
	origin := imageSrc0Origin()
	srcSize := max(imageSrc0Size(), vec2(1.0, 1.0))
	screenDim := max(ScreenSize, vec2(1.0, 1.0))
	minPos := origin + vec2(0.5, 0.5)
	maxPos := max(minPos, origin+srcSize-vec2(0.5, 0.5))

	uv := clamp((srcPos-origin)/srcSize, vec2(0.0, 0.0), vec2(1.0, 1.0))
	cUV := uv*2.0 - vec2(1.0, 1.0)
	t := mod(Time, 1024.0)
	chronosAmt := clamp(Chronos, 0.0, 1.0)
	rewindAmt := clamp(Rewind, 0.0, 1.0)

	outRGB := vec3(0.0, 0.0, 0.0)
	outAlpha := 1.0

	if Mode < 0.5 {
		// Mode 0: Pixel Crisp - exact pixel-center sample, zero CRT distortion/scanlines,
		// with subtle 8-tap optical bloom, gentle evening polish, and smooth Chronos/Rewind.
		base := imageSrc0UnsafeAt(clamp(srcPos, minPos, maxPos))
		bloom := dualRingBloom(uv, origin, srcSize, minPos, maxPos)
		bloomAdd := bloom * vec3(1.03, 0.99, 0.96) * 0.10

		rgb := eveningGrade(base.rgb, 0.55) + bloomAdd
		effectAlpha := max(bloomAdd.r, max(bloomAdd.g, bloomAdd.b))

		if chronosAmt > 0.001 {
			rad := length(cUV * vec2(0.92, 1.0))
			rim := smoothstep(0.46, 1.18, rad)
			pulse := 0.88 + 0.12*sin(t*7.2)
			rgb = applyChronos(rgb, cUV, t, chronosAmt, 0.80)
			effectAlpha = max(effectAlpha, rim*pulse*chronosAmt*0.24)
		}

		if rewindAmt > 0.001 {
			barPos := fract(-t * 2.1)
			bar := smoothstep(0.045, 0.0, abs(uv.y-barPos))
			scanPulse := step(0.55, fract(uv.y*screenDim.y*0.25+t*14.0)) * 0.08
			addBar := (bar*0.24 + scanPulse) * rewindAmt
			rgb = rgb + vec3(0.96, 0.26, 0.64)*addBar
			effectAlpha = max(effectAlpha, addBar)
		}

		outAlpha = clamp(max(base.a, effectAlpha), 0.0, 1.0)
		outRGB = clamp(rgb, vec3(0.0, 0.0, 0.0), vec3(outAlpha, outAlpha, outAlpha))
	} else if Mode < 1.5 {
		// Mode 1: Warm CRT (Default) - ultra-gentle barrel curve, silky dual-ring warm halation,
		// subtle 4.5% Trinitron scanlines, evening contrast grade, and warm amber vignette.
		r2 := dot(cUV, cUV)
		curved := cUV * (0.988 + 0.006*r2)
		crtUV := curved*0.5 + vec2(0.5, 0.5)

		bezelX := smoothstep(0.0, 0.004, crtUV.x) * smoothstep(1.0, 0.996, crtUV.x)
		bezelY := smoothstep(0.0, 0.005, crtUV.y) * smoothstep(1.0, 0.995, crtUV.y)
		cornerDist := length(max(abs(curved)-vec2(0.978, 0.978), vec2(0.0, 0.0)))
		cornerMask := 1.0 - smoothstep(0.014, 0.036, cornerDist)
		bezelMask := bezelX * bezelY * cornerMask

		if rewindAmt > 0.001 {
			tearWave := sin(crtUV.y*48.0-t*26.0) * 0.0022 * rewindAmt
			crtUV = vec2(crtUV.x+tearWave, crtUV.y)
		}

		// Soft vertical sub-pixel blend for crisp curved UI borders without stair-stepping.
		subHalfY := 0.20 / srcSize.y
		cTop := sampleClamped(crtUV-vec2(0.0, subHalfY), origin, srcSize, minPos, maxPos)
		cBot := sampleClamped(crtUV+vec2(0.0, subHalfY), origin, srcSize, minPos, maxPos)
		centerSample := mix(cTop, cBot, 0.5)
		rgb := centerSample.rgb

		// Rich 8-tap dual-ring warm halation & neon bloom.
		bloom := dualRingBloom(crtUV, origin, srcSize, minPos, maxPos)
		rgb = eveningGrade(rgb, 1.0) + bloom*(vec3(1.09, 0.97, 0.88)*0.20)

		// Soft subtle Trinitron horizontal scanlines (4.5% modulation) + delicate phosphor warmth.
		scanPhase := 0.5 + 0.5*sin(crtUV.y*screenDim.y*3.14159265)
		scanMod := 1.0 - 0.045*scanPhase
		triadPhase := sin(crtUV.x * screenDim.x * 3.14159265)
		triadTint := vec3(1.028+0.008*triadPhase, 1.005, 0.962-0.008*triadPhase)
		rgb = rgb * triadTint * scanMod

		// Soft warm amber edge vignette (14%).
		vigDist := length(cUV * vec2(0.86, 0.94))
		vig := 1.0 - smoothstep(0.68, 1.38, vigDist)*0.14
		rgb = mix(vec3(0.094, 0.052, 0.072), rgb, vig)

		if chronosAmt > 0.001 {
			rgb = applyChronos(rgb, cUV, t, chronosAmt, 1.0)
		}

		if rewindAmt > 0.001 {
			sweep1 := smoothstep(0.055, 0.0, abs(fract(crtUV.y-t*1.85)-0.5))
			sweep2 := smoothstep(0.025, 0.0, abs(fract(crtUV.y-t*3.10+0.37)-0.5))
			lineNoise := hash21(vec2(floor(crtUV.y*screenDim.y), floor(t*48.0)))
			rgb = rgb + vec3(1.0, 0.24, 0.68)*((sweep1*0.30+sweep2*0.22)*rewindAmt)
			rgb = rgb + vec3(0.95, 0.65, 0.90)*(step(0.86, lineNoise)*0.16*rewindAmt)
		}

		bezelCol := vec3(0.032, 0.018, 0.048)
		rgb = mix(bezelCol, rgb, bezelMask)
		outAlpha = 1.0
		outRGB = clamp(rgb, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
	} else {
		// Mode 2: VHS Noir - RGB chromatic aberration, stylized neon bleed, tape grain,
		// tracking bands, and evening neon-noir color grade.
		tSnap := floor(t * 16.0)
		bandY := floor(uv.y * 72.0)
		bandHash := hash21(vec2(bandY, tSnap))
		glitchBand := step(0.955, bandHash)

		trackPos := fract(t * 0.22)
		trackDist := min(abs(uv.y-trackPos), 1.0-abs(uv.y-trackPos))
		trackZone := smoothstep(0.065, 0.0, trackDist)

		tapeWave := sin(uv.y*22.0+t*5.0)*0.0007 + sin(uv.y*5.0-t*1.8)*0.0004
		rowNoise := (hash21(vec2(floor(uv.y*screenDim.y), floor(t*36.0))) - 0.5) * 2.0
		glitchAmp := clamp(trackZone*0.85+glitchBand*0.70+rewindAmt*1.15, 0.0, 1.5)
		xShiftPx := tapeWave*screenDim.x + glitchAmp*rowNoise*(1.4+4.8*rewindAmt)
		vhsUV := vec2(uv.x+xShiftPx/screenDim.x, uv.y)

		// Horizontal RGB aberration: ~1.2px normally, up to ~4px on glitch bands or rewind.
		chromaPx := 1.2 + clamp(trackZone*1.7+glitchBand*1.4+rewindAmt*2.8, 0.0, 2.8)
		chromaUV := chromaPx / screenDim.x

		rCol := sampleClamped(vhsUV+vec2(chromaUV, 0.0), origin, srcSize, minPos, maxPos).r
		gSample := sampleClamped(vhsUV, origin, srcSize, minPos, maxPos)
		bCol := sampleClamped(vhsUV-vec2(chromaUV, 0.0), origin, srcSize, minPos, maxPos).b
		rgb := vec3(rCol, gSample.g, bCol)

		// Stylized 8-tap dual-ring neon bleed + evening contrast & noir magenta/cyan shadow grade.
		bloom := dualRingBloom(vhsUV, origin, srcSize, minPos, maxPos)
		rgb = eveningGrade(rgb, 0.70) + bloom*(vec3(1.08, 0.92, 1.14)*0.20)

		luma := dot(rgb, vec3(0.299, 0.587, 0.114))
		shadowTone := smoothstep(0.15, 0.85, 1.0-luma)
		noirCool := rgb * vec3(0.95, 0.93, 1.09)
		rgb = mix(noirCool, noirCool*vec3(1.06, 0.89, 1.13), shadowTone*0.44)
		rgb = rgb + vec3(0.022, 0.008, 0.038)*shadowTone

		// Deterministic analog tape grain (gentle so UI text stays legible).
		pixCoord := floor(uv * screenDim)
		grainSeed := vec2(fract(t*23.7)*97.0, fract(t*17.3)*53.0)
		grain := (hash21(pixCoord+grainSeed) - 0.5) * (0.040 + 0.068*rewindAmt)
		rgb = rgb + vec3(grain*0.95, grain*0.85, grain*1.10)

		// VHS scanlines (~10% modulation).
		scanPhase := 0.5 + 0.5*sin(uv.y*screenDim.y*3.14159265)
		rgb = rgb * (1.0 - 0.10*scanPhase)

		if trackZone > 0.01 {
			tearNoise := hash21(vec2(floor(uv.x*screenDim.x*0.5), floor(uv.y*screenDim.y)+floor(t*40.0)))
			rgb = rgb + vec3(0.75, 0.88, 1.0)*(trackZone*step(0.74, tearNoise)*0.11)
		}

		if rewindAmt > 0.001 {
			bar1 := smoothstep(0.045, 0.0, abs(fract(uv.y-t*2.4)-0.22))
			bar2 := smoothstep(0.032, 0.0, abs(fract(uv.y-t*3.3)-0.72))
			snow := hash21(vec2(floor(uv.x*screenDim.x*0.5), floor(uv.y*screenDim.y)+fract(t*60.0)*131.0))
			staticMask := clamp(step(0.38, snow)*(bar1+bar2*0.85)*rewindAmt*0.82, 0.0, 0.85)
			snowCol := vec3(0.86, 0.92, 1.0) * (0.45 + 0.55*snow)
			rgb = mix(rgb, snowCol, staticMask)
			rgb = rgb + vec3(1.0, 0.22, 0.66)*((bar1*0.30+bar2*0.20)*rewindAmt)
		}

		if chronosAmt > 0.001 {
			rgb = applyChronos(rgb, cUV, t, chronosAmt, 1.0)
		}

		vig := 1.0 - smoothstep(0.66, 1.38, length(cUV))*0.22
		rgb = mix(vec3(0.055, 0.022, 0.088), rgb, vig)
		outAlpha = 1.0
		outRGB = clamp(rgb, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
	}

	return vec4(outRGB, outAlpha) * color
}
